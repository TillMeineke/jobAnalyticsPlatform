#!/bin/bash

# AWS credentials
export AWS_ACCESS_KEY_ID="your-access-key"
export AWS_SECRET_ACCESS_KEY="your-secret-key"
export AWS_DEFAULT_REGION="eu-central-1"

# Terraform variables
export TF_VAR_environment="dev"
export TF_VAR_ec2_key_name="your-key-pair-name"

# Uncomment and set if you want to use a specific Terraform state backend
# export TF_VAR_backend_bucket="terraform-state-job-pipeline"

echo "Environment variables set for Terraform!"
