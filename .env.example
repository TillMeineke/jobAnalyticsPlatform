# Environment settings
ENVIRONMENT=dev # Options: dev, test, prod

# AWS Configuration
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Database connection strings
ATHENA_OUTPUT_LOCATION=s3://job-market-data-dev/athena-results/

# API configuration
API_KEY=your_api_key_here
API_ENDPOINT=https://api.example.com/v1
REQUEST_TIMEOUT=30

# Logging
LOG_LEVEL=INFO # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=jobanalytics
DB_PASSWORD=jobanalytics
DB_NAME=jobanalytics

# Scraper Configuration
SCRAPER_MAX_RESULTS=100
SCRAPER_DAYS_BACK=30

# AWS Configuration (for cloud deployment)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# S3 Bucket Names
S3_BRONZE_BUCKET=job-analytics-bronze
S3_SILVER_BUCKET=job-analytics-silver
S3_GOLD_BUCKET=job-analytics-gold

# Metabase Configuration
METABASE_URL=http://localhost:3000

# Kestra Configuration
KESTRA_URL=http://localhost:8080

# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# StepStone scraper configuration
STEPSTONE_EMAIL=your_email@example.com
STEPSTONE_PASSWORD=your_password

# Scraper runtime limits
MAX_RUNTIME_SECONDS=1800 # 30 minutes
